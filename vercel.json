{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/entregador/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/pedidos",
      "destination": "/index.html"
    },
    {
      "source": "/rastrear",
      "destination": "/index.html"
    },
    {
      "source": "/conta/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/acesso-restrito",
      "destination": "/index.html"
    }
  ]
}
